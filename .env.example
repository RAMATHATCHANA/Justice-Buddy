# JusticeBuddy Environment Variables Template
# Copy this file to .env and fill in your actual values

# Database Configuration (Automatically set by Replit)
DATABASE_URL=sqlite:///./backend/case_tracker.db

# Twilio Configuration (for WhatsApp Notifications)
# Get these from https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Session Secret (for security)
SESSION_SECRET=your_random_secret_key_here

# Optional: Google Cloud Translation API (if using official API instead of googletrans)
# GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here
